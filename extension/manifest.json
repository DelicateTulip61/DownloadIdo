{
  "manifest_version": 3,
  "name": "DownloadIdo",
  "version": "1.0.0",
  "description": "Right-click any image or video to download it — even under overlays, CSS backgrounds and streamed videos.",
  "minimum_chrome_version": "121",
  "permissions": ["contextMenus", "declarativeNetRequestWithHostAccess", "downloads", "offscreen", "scripting", "storage", "webRequest", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "DownloadIdo — right-click an image or video to download it" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/mse-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/utils.js", "lib/fmp4.js", "content/detect.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
