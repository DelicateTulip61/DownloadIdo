{
  "name": "downloadido",
  "version": "1.0.0",
  "description": "Chrome extension: right-click any image or video to download it",
  "scripts": {
    "typecheck": "tsc -p jsconfig.json",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=extension/lib/** tests/unit/*.test.js tests/integration/*.test.mjs",
    "test:e2e": "node --test --test-timeout=120000 tests/e2e/*.e2e.test.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/chrome": "^0.3.4",
    "hls.js": "^1.7.3",
    "lamejs": "^1.2.1",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
